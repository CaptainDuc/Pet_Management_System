# ─── Service-owned PostgreSQL databases ──────────────────────────────────────
BACKEND_DB_NAME=petcare
BACKEND_DB_USER=petcare
BACKEND_DB_PASSWORD=petcare123

PAYMENT_DB_NAME=petcare_payment
PAYMENT_DB_USER=petcare_payment
PAYMENT_DB_PASSWORD=petcare_payment123

NOTIFICATION_DB_NAME=petcare_notification
NOTIFICATION_DB_USER=petcare_notification
NOTIFICATION_DB_PASSWORD=petcare_notification123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=petcare
RABBITMQ_PASSWORD=petcare123

# ─── Notification Providers ──────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── AI Services ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
VITE_AI_AGENT_URL=http://localhost:8001
VITE_NOTIFICATION_URL=http://localhost:8083/api/v1

# ─── SePay Payment Gateway ───────────────────────────────────────────────────
# Webhook API key configured in SePay dashboard (Authorization: Apikey <key>)
SEPAY_API_KEY=sepay_local_dev_key
# Receiving bank account (VietQR)
BANK_ACCOUNT_NUMBER=0123456789
BANK_CODE=MB
BANK_ACCOUNT_NAME=PETCARE SERVICE
# Prefix used to build the transfer reference, e.g. DH1024
PAYMENT_PREFIX=DH

# Shared secret for internal service-to-service calls (payment-service -> backend)
INTERNAL_API_KEY=petcare_internal_dev_key

# Frontend Payment Service base URL
VITE_PAYMENT_URL=http://localhost:8082/api/v1
