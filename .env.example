# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=petcare
POSTGRES_USER=petcare
POSTGRES_PASSWORD=petcare123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=petcare
RABBITMQ_PASSWORD=petcare123

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── AI Services ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
VITE_AI_AGENT_URL=http://localhost:8001
