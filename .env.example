# ─── Service-owned PostgreSQL databases ──────────────────────────────────────
BACKEND_DB_NAME=petcare
BACKEND_DB_USER=petcare
BACKEND_DB_PASSWORD=petcare123

PAYMENT_DB_NAME=petcare_payment
PAYMENT_DB_USER=petcare_payment
PAYMENT_DB_PASSWORD=petcare_payment123

NOTIFICATION_DB_NAME=petcare_notification
NOTIFICATION_DB_USER=petcare_notification
NOTIFICATION_DB_PASSWORD=petcare_notification123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=petcare
RABBITMQ_PASSWORD=petcare123

# ─── Notification Providers ──────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── AI Services ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
VITE_AI_AGENT_URL=http://localhost:8001
